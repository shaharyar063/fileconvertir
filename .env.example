# Optional: canonical site URL used for sitemap, canonicals, and prerender meta.
# Defaults to https://fileconvertir.com if unset.
# VITE_SITE_URL="https://fileconvertir.com"

# Optional: serve FFmpeg.wasm core from your own host instead of unpkg.com.
# Useful if you self-host the core under public/ffmpeg/ on Cloudflare Pages.
# VITE_FFMPEG_BASE_URL="/ffmpeg"
